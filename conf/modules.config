/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
    ]

    withName: GATK4_GENOTYPEGVCFS {
        ext.prefix = { "${meta.name}.normal" }
        publishDir = [
            mode: params.publish_dir_mode,
            path: { "${params.outdir}/gvcftovcf/${meta.label}/" },
        ]
    }

    withName: BEFORE_FILTER_STATS {
        ext.prefix = { "${meta.name}" }
        publishDir = [
            mode: params.publish_dir_mode,
            path: { "${params.outdir}/bcftools/stats/${meta.label}/" },
        ]
    }

    withName: BCFTOOLS_VIEW {
        ext.prefix = { "${meta.name}.filter" }
        ext.args   = { "--output-type z --write-index=tbi -i '${params.filter}'" }
        publishDir = [
            mode: params.publish_dir_mode,
            path: { "${params.outdir}/bcftools/view/${meta.label}/" },
        ]
    }

    withName: AFTER_FILTER_STATS {
        ext.prefix = { "${meta.name}.filter" }
        publishDir = [
            mode: params.publish_dir_mode,
            path: { "${params.outdir}/bcftools/stats/${meta.label}/" },
        ]
    }

    withName: BCFTOOLS_CONCAT {
        ext.prefix = { "${meta.id}.${meta.label}.${meta.status}.concat" }
        ext.args   = { " --allow-overlaps --output-type z --write-index=tbi" }
        publishDir = [
            mode: params.publish_dir_mode,
            path: { "${params.outdir}/bcftools/concat/" },
        ]
    }

    withName: CREATE_SAMPLE_FILE {
        ext.prefix = { "${meta.label}" }
        publishDir = [
            mode: params.publish_dir_mode,
            path: { "${params.outdir}/bcftools/reheader/samplefiles/" },
        ]
    }

    withName: BCFTOOLS_REHEADER {
        errorStrategy = { task.attempt <= 3 ? 'retry' : 'terminate' }
        maxRetries    = 3
        ext.prefix    = { "${meta.id}.${meta.label}.${meta.status}.reheader" }
        ext.args2     = { "--output-type z --write-index=tbi" }
        publishDir    = [
            mode: params.publish_dir_mode,
            path: { "${params.outdir}/bcftools/reheader/${meta.id}/" },
        ]
    }

    withName: BCFTOOLS_MERGE {
        ext.args   = { "--force-samples --output-type z --write-index=tbi" }
        // ${meta.status} is required now that the filtered and full arms stay
        // separate: without it both arms publish HG00097.merge.vcf.gz to the same
        // directory and the second overwrites the first.
        ext.prefix = { "${meta.id}.${meta.status}.merge" }
        publishDir = [
            mode: params.publish_dir_mode,
            path: { "${params.outdir}/bcftools/merge/" },
        ]
    }

    withName: BCFTOOLS_ANNOTATE {
        ext.args   = { "-x ID --output-type z --write-index=tbi" }
        ext.prefix = { "${meta.id}.${meta.status}.IDremoved" }
        publishDir = [
            mode: params.publish_dir_mode,
            path: { "${params.outdir}/bcftools/annotate/" },
        ]
    }

    withName: VCF2COUNTS {
        // The CSV FILENAME must stay ${meta.id}.csv and must not gain a status
        // suffix: counts2rds.py takes sample_name from the filename stem, so
        // HG00097.filtered.csv would become sample name "HG00097.filtered", fail
        // to match the metadata and be dropped as an unknown sample. The arms are
        // separated by directory instead, which leaves the name intact.
        publishDir = [
            mode: params.publish_dir_mode,
            path: { "${params.outdir}/vcf2counts/${meta.status}/" },
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: COUNTS2RDS {
        // meta.id is already arm-specific (all_samples_null / all_samples_filtered)
        // so the two arms cannot collide here. Published per arm to keep the two
        // count matrices -- and their --write-csv dumps -- apart on disk.
        publishDir = [
            mode: params.publish_dir_mode,
            path: { "${params.outdir}/counts2rds/${meta.mode}/" },
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: MULTIQC {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    // The diversity step is the pipeline's memory bottleneck. hill.R forks
    // workers (copy-on-write on the count table) when --parallel is left at its
    // 'auto' default, but each worker still allocates its own resampled subsets
    // and hillR intermediates, so cores must stay modest and numvariants must be
    // capped while a single table stands in for both arms. See hill_max_variants
    // in nextflow.config for why the cap exists and when to remove it.
    withName: DIVANALYSIS_HILL {
        cpus     = { params.hill_cores }
        ext.args = { "--max-variants ${params.hill_max_variants}" }
    }

    //
    // Split diversity path: generate -> per-batch fan-out -> aggregate.
    //
    // The point of the split is that DIVANALYSIS_BATCHPROC runs once per batch,
    // so the memory ceiling is per TASK rather than per pipeline run, and the
    // scheduler decides how many run at once. Published so the batches and the
    // per-batch results can be inspected after a failure.
    //
    withName: DIVANALYSIS_BATCHGEN {
        // Generation is single-threaded on purpose; it is one task, not a fan-out.
        cpus   = 1
        publishDir = [
            path: { "${params.outdir}/divanalysis/batches" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
        ext.args = { "--max-variants ${params.hill_max_variants}" }
    }

    withName: DIVANALYSIS_BATCHPROC {
        // One batch is ~1.2 GB peak measured, so 2 cpus would be wasted
        // (it is serial within a task) and memory is what governs how many run
        // at once.
        cpus   = 1
        // Declared explicitly because the inherited process_low label asks for
        // 12.G * task.attempt (6 GB after the denbi clamp), which lets only ONE
        // task fit on the ~7.9 GB host and serialises the whole fan-out -- the
        // exact opposite of what the split is for. 2 GB per task keeps real
        // headroom over the measured 1.2 GB while allowing three batches to run
        // concurrently.
        memory = { 2.GB * task.attempt }
        // Retries are per batch, which is the recovery granularity this buys.
        publishDir = [
            path: { "${params.outdir}/divanalysis/batch_results" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: DIVANALYSIS_AGGREGATE {
        publishDir = [
            path: { "${params.outdir}/divanalysis" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }
}
